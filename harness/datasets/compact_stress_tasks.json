{
  "name": "compact_stress_tasks",
  "description": "Multi-step repo tasks likely to trigger L1 context compaction",
  "version": "0.1.0",
  "tasks": [
    {
      "id": "hard_multi_read_chain",
      "description": "Read every file under parts/ plus aggregator.py before fixing the bug. The test expects total() to return 10. Do not change tests.",
      "fixture_dir": "tests/fixtures/repos/hard_multi_read_chain",
      "expected": {
        "type": "multi_assert",
        "assertions": [
          {"type": "command_success", "command": "python -m pytest -q", "timeout": 30},
          {"type": "file_contains", "path": "aggregator.py", "keywords": ["GAMMA"]}
        ]
      },
      "difficulty": "hard",
      "tags": ["repo", "multi-file", "context-stress", "pytest"]
    },
    {
      "id": "hard_cross_file_api",
      "description": "Fix the API behavior across api.py and storage.py. Existing users should display as 'Name (role)', and missing users should return 'Unknown user'.",
      "fixture_dir": "tests/fixtures/repos/hard_cross_file_api",
      "expected": {
        "type": "multi_assert",
        "assertions": [
          {"type": "command_success", "command": "python -m pytest -q", "timeout": 30},
          {"type": "file_contains", "path": "api.py", "keywords": ["Unknown user", "role"]}
        ]
      },
      "difficulty": "hard",
      "tags": ["repo", "cross-file", "context-stress", "pytest"]
    },
    {
      "id": "hard_report_transform",
      "description": "Update report.py so running it reads input.csv and writes summary.md with a score table and grades. Scores >= 90 are A, otherwise B.",
      "fixture_dir": "tests/fixtures/repos/hard_report_transform",
      "expected": {
        "type": "multi_assert",
        "assertions": [
          {"type": "command_success", "command": "python report.py", "timeout": 30},
          {"type": "command_success", "command": "python check_report.py", "keywords": ["report ok"], "timeout": 30},
          {"type": "file_contains", "path": "summary.md", "keywords": ["# Score Summary", "| Name | Score | Grade |"]}
        ]
      },
      "difficulty": "hard",
      "tags": ["repo", "transform", "context-stress"]
    }
  ]
}
