      "required": [
        "memory_id",
        "revision",
        "score",
        "selected",
        "reasons",
        "validity"
      ],
      "title": "GateItem",
      "type": "object"
    },
    "ValidityResult": {
      "additionalProperties": false,
      "properties": {
