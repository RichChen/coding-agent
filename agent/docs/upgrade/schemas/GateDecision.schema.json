        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "requested_hash": {
          "title": "Requested Hash",
          "type": "string"
        },
        "requested_chars": {
          "title": "Requested Chars",
          "type": "integer"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
