          "title": "Memory Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
