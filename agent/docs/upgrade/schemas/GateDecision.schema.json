      },
      "title": "Items",
      "type": "array"
    },
    "requested_chars": {
      "title": "Requested Chars",
      "type": "integer"
    },
    "external_model_calls": {
      "default": 0,
      "title": "External Model Calls",
      "type": "integer"
    }
