{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "logical_id": {
          "minLength": 1,
          "title": "Logical Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "default": "text/plain",
          "title": "Media Type",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sensitivity": {
          "const": "public_observation",
          "default": "public_observation",
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "logical_id",
        "sha256",
        "size_bytes",
        "run_id",
        "relative_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "model_calls": {
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "retry_limit": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Limit",
          "type": "integer"
        },
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        }
      },
      "required": [
        "wall_seconds",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "tool_calls"
      ],
      "title": "Budget",
      "type": "object"
    },
    "PublicContext": {
      "additionalProperties": false,
      "properties": {
        "reproduction": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reproduction",
          "type": "array"
        },
        "public_test_commands": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Public Test Commands",
          "type": "array"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Observations",
          "type": "array"
        }
      },
      "title": "PublicContext",
      "type": "object"
    },
    "RepoRef": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "minLength": 1,
          "title": "Repo Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "revision_kind": {
          "default": "snapshot",
          "enum": [
            "commit",
            "snapshot"
          ],
          "title": "Revision Kind",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "revision"
      ],
      "title": "RepoRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_family": {
      "const": "code_repair",
      "default": "code_repair",
      "title": "Task Family",
      "type": "string"
    },
    "issue_text": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Issue Text",
      "type": "string"
    },
    "repo_ref": {
      "$ref": "#/$defs/RepoRef"
    },
    "public_context": {
      "$ref": "#/$defs/PublicContext"
    },
    "workspace_id": {
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "allowed_tools": {
      "items": {
        "enum": [
          "read",
          "search",
          "patch",
          "public_test"
        ],
        "type": "string"
      },
      "title": "Allowed Tools",
      "type": "array"
    },
    "execution_profile_ref": {
      "minLength": 1,
      "title": "Execution Profile Ref",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "protocol_mode": {
      "default": "realistic",
      "enum": [
        "realistic",
        "diagnostic_oracle"
      ],
      "title": "Protocol Mode",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "repeat_id": {
      "default": 0,
      "minimum": 0,
      "title": "Repeat Id",
      "type": "integer"
    }
  },
  "required": [
    "task_id",
    "issue_text",
    "repo_ref",
    "workspace_id",
    "allowed_tools",
    "execution_profile_ref",
    "budget"
  ],
  "title": "PublicTask",
  "type": "object"
}
